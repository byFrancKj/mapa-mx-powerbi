// =====================================================================
// Dim_Calendario  (Modelado > Nueva tabla, pega desde "Dim_Calendario =")
// Después: márcala como tabla de fechas (columna Fecha) y relaciónala con
// Fact_Cadenas[FECHA] y Fact_Nielsen[FECHA].
//
// Va del 1 de enero del primer año con datos al último día del último mes con
// datos. Terminar en el último mes (y no el 31 de diciembre) hace que "Año = 2026"
// compare ene-sep 2026 contra ene-sep 2025 y no contra todo 2025.
// Nielsen llega por periodo (FECHA = primer día del periodo): para comparar
// fuentes filtra por Año, Mes, Bimestre o Año-Mes, no por días sueltos.
// =====================================================================
Dim_Calendario =
VAR _ini = MIN ( MIN ( Fact_Cadenas[FECHA] ), MIN ( Fact_Nielsen[FECHA] ) )
VAR _fin = MAX ( MAX ( Fact_Cadenas[FECHA] ), MAX ( Fact_Nielsen[FECHA] ) )
VAR _fechas =
    SELECTCOLUMNS (
        CALENDAR ( DATE ( YEAR ( _ini ), 1, 1 ), EOMONTH ( _fin, 0 ) ),
        "Fecha", [Date]
    )
RETURN
    ADDCOLUMNS (
        _fechas,
        "Año", YEAR ( [Fecha] ),
        "Mes", MONTH ( [Fecha] ),
        "Nombre Mes", FORMAT ( [Fecha], "mmm", "es-MX" ),
        "Año-Mes", FORMAT ( [Fecha], "yyyy-mm" ),
        "Bimestre", "B" & ROUNDUP ( MONTH ( [Fecha] ) / 2, 0 ),
        "Año-Bimestre", YEAR ( [Fecha] ) & "-B" & ROUNDUP ( MONTH ( [Fecha] ) / 2, 0 ),
        "Trimestre", "T" & QUARTER ( [Fecha] ),
        "Semana ISO", WEEKNUM ( [Fecha], 21 ),
        "Inicio Semana (lunes)", [Fecha] - WEEKDAY ( [Fecha], 3 )
    )
