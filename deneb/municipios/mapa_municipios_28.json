  "layer": [
    {
      "description": "Base: todas las áreas, incluso las que no tienen datos",
      "data": {
        "name": "mx_municipios",
        "format": {
          "type": "topojson",
          "feature": "municipios"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ffffff",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6
      }
    },
    {
      "description": "Áreas con datos, coloreadas por clase",
      "transform": [
        {
          "lookup": "CVEGEO",
          "from": {
            "data": {
              "name": "mx_municipios",
              "format": {
                "type": "topojson",
                "feature": "municipios"
              }
            },
            "key": "properties.CVEGEO"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum.geo)"
        },
        {
          "calculate": "toNumber(datum['Valor Mapa'])",
          "as": "_v"
        },
        {
          "filter": "isValid(datum._v) && isFinite(datum._v)"
        },
        {
          "calculate": "isValid(datum['Config Mapa']) ? split(datum['Config Mapa'], '|') : ['secuencial','0','0','0','','','','','','']",
          "as": "_cfg"
        },
        {
          "calculate": "datum._cfg[0] == 'divergente' ? 'divergente' : 'secuencial'",
          "as": "_escala"
        },
        {
          "calculate": "toNumber(datum._cfg[1])",
          "as": "_c"
        },
        {
          "calculate": "toNumber(datum._cfg[2])",
          "as": "_u1"
        },
        {
          "calculate": "toNumber(datum._cfg[3])",
          "as": "_u2"
        },
        {
          "calculate": "datum._cfg[9]",
          "as": "_titulo"
        },
        {
          "calculate": "isValid(datum['Valor Mapa Texto']) ? datum['Valor Mapa Texto'] : format(datum._v, ',.4~g')",
          "as": "_txt"
        },
        {
          "window": [
            {
              "op": "ntile",
              "param": 5,
              "as": "_q"
            }
          ],
          "sort": [
            {
              "field": "_v",
              "order": "ascending"
            }
          ]
        },
        {
          "calculate": "datum._escala == 'divergente' ? (datum._v < datum._c - datum._u2 ? 1 : datum._v < datum._c - datum._u1 ? 2 : datum._v <= datum._c + datum._u1 ? 3 : datum._v <= datum._c + datum._u2 ? 4 : 5) : datum._q",
          "as": "_clase"
        },
        {
          "joinaggregate": [
            {
              "op": "argmin",
              "field": "_v",
              "as": "_min"
            },
            {
              "op": "argmax",
              "field": "_v",
              "as": "_max"
            }
          ],
          "groupby": [
            "_clase"
          ]
        },
        {
          "calculate": "datum._escala == 'divergente' ? (length(datum._cfg[3 + datum._clase]) > 0 ? datum._cfg[3 + datum._clase] : ['Muy por debajo','Por debajo','Similar','Por encima','Muy por encima'][datum._clase - 1]) : (datum._min._txt == datum._max._txt ? datum._min._txt : datum._min._txt + ' – ' + datum._max._txt)",
          "as": "_etq"
        },
        {
          "calculate": "datum._escala == 'divergente' ? ['#e34948','#ea9c9a','#f0efec','#9ec5f4','#2a78d6'][datum._clase - 1] : ['#cde2fb','#86b6ef','#3987e5','#1c5cab','#0d366b'][datum._clase - 1]",
          "as": "_color"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "_rank"
            }
          ],
          "sort": [
            {
              "field": "_v",
              "order": "descending"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "_n"
            }
          ]
        },
        {
          "calculate": "datum._rank + ' de ' + datum._n",
          "as": "_lugar"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": [
              "CVEGEO"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "cursor": "pointer"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
