          "as": "_color"
        },
        {
          "aggregate": [
            {
              "op": "min",
              "field": "_color",
              "as": "color"
            },
            {
              "op": "min",
              "field": "_etq",
              "as": "etq"
            }
          ],
          "groupby": [
            "_clase"
          ]
        },
        {
          "calculate": "5 - datum._clase",
          "as": "y0"
        },
        {
          "calculate": "datum.y0 + 0.78",
          "as": "y1"
        },
