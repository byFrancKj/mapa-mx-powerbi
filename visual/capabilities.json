{
    "dataRoles": [
        {
            "name": "ubicacion",
            "kind": "Grouping",
            "displayName": "Ubicación (clave INEGI)",
            "description": "Clave INEGI: CVE_ENT (estado, 2 dígitos) o CVEGEO (municipio, 5 dígitos), como texto o número. Admite una jerarquía estado → municipio para hacer drill-down.",
            "displayNameKey": "Rol_Ubicacion",
            "descriptionKey": "Rol_Ubicacion_Desc"
        },
        {
            "name": "grupo",
            "kind": "Grouping",
            "displayName": "Grupo (región)",
            "description": "Columna con el grupo de cada área (por ejemplo, tu región). El visual dibuja su contorno.",
            "displayNameKey": "Rol_Grupo",
            "descriptionKey": "Rol_Grupo_Desc"
        },
        {
            "name": "valor",
            "kind": "Measure",
            "displayName": "Valor",
            "description": "La medida que colorea el mapa. Puede ser cualquiera de tu modelo.",
            "displayNameKey": "Rol_Valor",
            "descriptionKey": "Rol_Valor_Desc"
        },
        {
            "name": "valor2",
            "kind": "Measure",
            "displayName": "Valor 2 (bivariado)",
            "displayNameKey": "Rol_Valor2",
            "descriptionKey": "Rol_Valor2_Desc",
            "description": "Segunda medida: con ella el mapa es bivariado (terciles de Valor contra terciles de Valor 2)."
        },
        {
            "name": "bases",
            "kind": "Measure",
            "displayName": "Bases a comparar",
            "description": "Medidas de cada fuente (por ejemplo Ventas Cadenas y Ventas Nielsen). El panel de detalle las compara: diferencia, diferencia % e índice contra la primera.",
            "displayNameKey": "Rol_Bases",
            "descriptionKey": "Rol_Bases_Desc"
        },
        {
            "name": "tarjetas",
            "kind": "Measure",
            "displayName": "Tarjetas",
            "description": "Medidas DAX que se muestran como tarjetas en el panel de detalle del estado o los estados seleccionados.",
            "displayNameKey": "Rol_Tarjetas",
            "descriptionKey": "Rol_Tarjetas_Desc"
        },
        {
            "name": "tooltips",
            "kind": "Measure",
            "displayName": "Información sobre herramientas",
            "description": "Medidas adicionales que se muestran al pasar el cursor.",
            "displayNameKey": "Rol_Tooltips",
            "descriptionKey": "Rol_Tooltips_Desc"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "grupo": {
                        "max": 1
                    },
                    "valor": {
                        "max": 1
                    },
                    "valor2": {
                        "max": 1
                    },
                    "bases": {
                        "max": 4
                    },
                    "tarjetas": {
                        "max": 8
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "ubicacion"
                            }
                        },
                        {
                            "bind": {
                                "to": "grupo"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "valor"
                            }
                        },
                        {
                            "bind": {
                                "to": "valor2"
                            }
                        },
                        {
                            "for": {
                                "in": "bases"
                            }
                        },
                        {
                            "for": {
                                "in": "tarjetas"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "drilldown": {
        "roles": [
            "ubicacion"
        ]
    },
