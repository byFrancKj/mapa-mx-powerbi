{
    "dataRoles": [
        {
            "name": "ubicacion",
            "kind": "Grouping",
            "displayName": "Ubicación (clave INEGI)",
            "description": "Clave INEGI: CVE_ENT (estado, 2 dígitos) o CVEGEO (municipio, 5 dígitos), como texto o número. Admite una jerarquía estado → municipio para hacer drill-down."
        },
        {
            "name": "grupo",
            "kind": "Grouping",
            "displayName": "Grupo (región)",
            "description": "Columna con el grupo de cada área (por ejemplo, tu región). El visual dibuja su contorno."
        },
        {
            "name": "valor",
            "kind": "Measure",
            "displayName": "Valor",
            "description": "La medida que colorea el mapa. Puede ser cualquiera de tu modelo."
        },
        {
            "name": "tooltips",
            "kind": "Measure",
            "displayName": "Información sobre herramientas",
            "description": "Medidas adicionales que se muestran al pasar el cursor."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "grupo": {
                        "max": 1
                    },
                    "valor": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "ubicacion"
                            }
                        },
                        {
                            "bind": {
                                "to": "grupo"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "valor"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "drilldown": {
        "roles": [
            "ubicacion"
        ]
    },
    "objects": {
        "colores": {
            "properties": {
                "metodo": {
                    "type": {
                        "enumeration": []
                    }
                },
                "clases": {
                    "type": {
                        "integer": true
                    }
                },
                "paleta": {
                    "type": {
                        "enumeration": []
                    }
                },
                "paletaDivergente": {
                    "type": {
                        "enumeration": []
                    }
                },
                "centro": {
                    "type": {
                        "numeric": true
                    }
                },
                "umbral1": {
                    "type": {
                        "numeric": true
                    }
                },
                "umbral2": {
                    "type": {
                        "numeric": true
                    }
                },
                "invertir": {
                    "type": {
                        "bool": true
                    }
                },
                "sinDato": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "mapa": {
            "properties": {
                "proyeccion": {
                    "type": {
                        "enumeration": []
                    }
                },
                "borde": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "grosor": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "grupos": {
            "properties": {
                "contorno": {
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "grosor": {
                    "type": {
                        "numeric": true
                    }
                },
                "limitesInternos": {
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "leyenda": {
            "properties": {
                "mostrar": {
                    "type": {
                        "bool": true
                    }
                },
                "posicion": {
                    "type": {
                        "enumeration": []
                    }
                },
                "titulo": {
                    "type": {
                        "text": true
                    }
                },
                "tamano": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        }
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltips"
        ]
    },
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "privileges": []
}
